# Configuración de Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Límites y atención comercial
MAX_DAILY_QUERIES=15
WHATSAPP_NUMBER=51964451902
FALLBACK_DEMO_MODE=true

# Seguridad y red
TRUST_CLOUDFLARE_PROXY=false
# Origenes autorizados a llamar a la API desde otro dominio (lista separada por comas, sin barra final).
# En produccion usar el sitio que incrusta el widget; '*' solo para desarrollo.
ALLOWED_ORIGINS=https://yointi.com,https://www.yointi.com
